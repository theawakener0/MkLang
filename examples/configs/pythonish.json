{
  "name": "Pythonish",
  "module": "github.com/yourname/pythonish",
  "version": "0.1.0",
  "features": {
    "floats": true,
    "strings": true,
    "arrays": true,
    "hashes": true,
    "for_loops": true,
    "infinite_loops": false,
    "try": false,
    "prefix_postfix_inc_dec": false,
    "compound_assignment": true,
    "elseif": true,
    "matrices": false,
    "auto_semicolons": true,
    "comments": true,
    "block_comments": false
  },
  "comments": {
    "line": "#",
    "block_start": "",
    "block_end": ""
  },
  "identifier": {
    "start_letters": true,
    "extra_start": "_",
    "part_letters_digits": true,
    "extra_part": "_"
  },
  "string": {
    "delimiter": "\"",
    "escape_sequences": true
  },
  "keywords": {
    "def": "FUNCTION",
    "True": "TRUE",
    "False": "FALSE",
    "None": "NULL",
    "if": "IF",
    "elif": "ELSEIF",
    "else": "ELSE",
    "return": "RETURN",
    "for": "FOR",
    "break": "BREAK",
    "continue": "CONTINUE",
    "and": "LAND",
    "or": "LOR",
    "not": "BANG"
  },
  "symbols": {
    "=": "ASSIGNCHAR",
    "==": "EQ",
    "!=": "NOTEQ",
    "+": "PLUS",
    "-": "MINUS",
    "*": "ASTERISK",
    "/": "SLASH",
    "+=": "INCASSIGN",
    "-=": "DECDASSIGN",
    "*=": "MLTASSIGN",
    "/=": "DIVASSIGN",
    "<": "LT",
    "<=": "LTEQ",
    ">": "GT",
    ">=": "GTEQ",
    ";": "SEMICOLON",
    ",": "COMMA",
    ":": "COLOMN",
    ".": "DOT",
    "(": "LPAREN",
    ")": "RPAREN",
    "{": "LBRACE",
    "}": "RBRACE",
    "[": "LBRACKET",
    "]": "RBRACKET"
  },
  "builtins": {
    "print": "println",
    "printf": "printf",
    "input": "input",
    "len": "len",
    "int": "int",
    "float": "float",
    "str": "string",
    "type": "type",
    "first": "first",
    "last": "last",
    "pop": "pop",
    "push": "push",
    "insert": "insert",
    "remove": "remove",
    "keys": "keys",
    "vals": "vals",
    "contains": "contains",
    "random": "random",
    "make": "make",
    "color": "color",
    "sleep": "sleep",
    "exp": "exp",
    "pi": "pi"
  },
  "statement_end_tokens": [
    "IDENT",
    "INT",
    "FLOAT",
    "STRING",
    "TRUE",
    "FALSE",
    "NULL",
    "RPAREN",
    "RBRACKET",
    "RBRACE",
    "RETURN",
    "BREAK",
    "CONTINUE"
  ],
  "output": {
    "true": "True",
    "false": "False",
    "null": "None",
    "break": "break",
    "continue": "continue",
    "function": "def",
    "array_open": "[",
    "array_close": "]",
    "array_separator": ", ",
    "hash_open": "{",
    "hash_close": "}",
    "hash_separator": ", ",
    "hash_keyval": ": "
  }
}
